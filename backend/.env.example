# Server
PORT=5000
NODE_ENV=development

# MongoDB
MONGO_URI=mongodb://127.0.0.1:27017/ecommerce

# Auth
JWT_SECRET=replace_with_a_long_random_string
JWT_EXPIRES_IN=30d

# CORS - comma separated list of allowed origins (web dev server, deployed web app)
CORS_ORIGINS=http://localhost:5173,http://localhost:19006

# Limits
RECENTLY_VIEWED_MAX=20
CONTINUE_SHOPPING_MAX=10
