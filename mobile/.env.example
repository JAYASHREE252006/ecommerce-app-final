# Expo (SDK 49+) exposes vars prefixed with EXPO_PUBLIC_ to app code via process.env.
#
# IMPORTANT - Android "localhost" gotcha:
# On an Android EMULATOR, "localhost" refers to the emulator itself, not your
# dev machine. Use 10.0.2.2 instead, which the emulator maps back to your host.
# On a PHYSICAL Android device (Expo Go / dev build) over Wi-Fi, use your
# computer's LAN IP address (e.g. 192.168.1.23), since the device is not
# your machine at all. iOS simulator can use localhost directly.

# Android emulator:
EXPO_PUBLIC_API_URL=http://10.0.2.2:5000/api
EXPO_PUBLIC_SOCKET_URL=http://10.0.2.2:5000

# Physical device example (uncomment and replace with your LAN IP):
# EXPO_PUBLIC_API_URL=http://192.168.1.23:5000/api
# EXPO_PUBLIC_SOCKET_URL=http://192.168.1.23:5000

# Production:
# EXPO_PUBLIC_API_URL=https://api.yourdomain.com/api
# EXPO_PUBLIC_SOCKET_URL=https://api.yourdomain.com
